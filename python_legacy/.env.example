# ─────────────────────────────────────────────────────────────────────────────
# Movie Catalog — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────────────────────────────────

# Server port
PORT=5000

# SQLite database file path (used when DATABASE_URL points to a .db file)
DATABASE_URL=./database/movie_catalog.db

# PostgreSQL connection variables (for future migration from SQLite)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=yourpassword
DB_NAME=movie_catalog

# Flask secret key (used for session security)
SECRET_KEY=change-me-to-a-random-secret
